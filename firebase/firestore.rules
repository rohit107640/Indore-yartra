rules_version = '2';

// Public website can only CREATE enquiries, with strict validation.
// Nobody can read, edit or delete them from the browser — view them
// in the Firebase Console (Firestore Database → enquiries).
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidEnquiry(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'type', 'item', 'date', 'travellers',
                               'pickup', 'destination', 'message', 'source', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'type', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
        && d.email is string && d.email.size() <= 120
        && d.type in ['Tour Package', 'One-way Taxi', 'Cab Booking', 'Airport Transfer', 'General']
        && d.item is string && d.item.size() <= 120
        && d.date is string && d.date.size() <= 20
        && d.travellers is int && d.travellers >= 1 && d.travellers <= 100
        && d.pickup is string && d.pickup.size() <= 80
        && d.destination is string && d.destination.size() <= 120
        && d.message is string && d.message.size() <= 1000
        && d.source is string && d.source.size() <= 60
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiry(request.resource.data);
      allow read, update, delete: if false;
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
